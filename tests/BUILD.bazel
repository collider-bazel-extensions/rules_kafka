"""Tests for rules_kafka.

- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + Bitnami Kafka (KRaft, single
  combined controller+broker, PLAINTEXT). Smoke `kubectl exec`s into
  the broker pod, creates a topic, produces a unique payload via
  `kafka-console-producer.sh`, consumes from offset 0 via
  `kafka-console-consumer.sh`, and asserts the payload round-trips.
  Exercises the controller (KRaft metadata), broker (log append +
  fetch), and producer/consumer protocol path — not "kafka pod is up."
"""

load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kafka//:defs.bzl", "kafka_health_check", "kafka_install")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "kafka_install_test_suite")

# ---- analysis ---------------------------------------------------------------

kafka_install_test_suite(name = "kafka_install_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.35")
kind_health_check(name = "cluster_health", cluster = ":cluster")
itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

kafka_install(
    name = "kafka_install_bin",
    tags = ["manual"],
)

kafka_health_check(
    name = "kafka_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "kafka_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":kafka_install_bin"],
)

sh_binary(
    name = "kafka_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":kafka_health_bin"],
)

itest_service(
    name = "kafka_svc",
    exe = ":kafka_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":kafka_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":kafka_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
